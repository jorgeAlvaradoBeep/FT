<UserControl x:Class="Facturacion_Tostatronic.Views.Pages.Products.LoadNewPrices"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Facturacion_Tostatronic.Views.Pages.Products" 
             xmlns:local2="clr-namespace:Facturacion_Tostatronic.ViewModels.Products" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation" 
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             mc:Ignorable="d" 
             d:DesignHeight="760" 
             d:DesignWidth="1360"
             Background="White"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <!-- DataTemplate para Page1ViewModel -->
        <DataTemplate DataType="{x:Type local2:UpdateProductNOVM}">
            <local:UpdateProductUC/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local2:AddProductVM}">
            <local:AddProductUC/>
        </DataTemplate>
    </UserControl.Resources>
    <telerik:RadBusyIndicator IsBusy="{Binding IsBusy}" 
                              BusyContent="Cargando productos...">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <telerik:LayoutControlGroup HorizontalAlignment="Left" 
                        VerticalAlignment="Top" 
                        Grid.Column="4" 
                        Grid.ColumnSpan="4" 
                        Grid.RowSpan="3" 
                        Orientation="Vertical">
                <telerik:Label Content="Productos Cargados:" 
                   Margin="10" 
                   FontSize="34" 
                   HorizontalAlignment="Left" 
                   Width="530"/>
                <telerik:RadComboBox Grid.Row="0" 
                     x:Name="cbOrdenes"
                     ItemsSource="{Binding Ordenes}"
                     SelectedValue="{Binding SelectedOrder}"
                     SelectedIndex="-1"
                     Width="200"
                     Margin="10"
                     SelectionChanged="cbOrdenes_SelectionChanged"/>
                                     
            </telerik:LayoutControlGroup>
            <telerik:RadGridView x:Name="RadGrdVProducts"
                                ShowGroupPanel="False"
                                CanUserFreezeColumns="False"
                                CanUserResizeColumns="False"
                                RowIndicatorVisibility="Collapsed"
                                Grid.Column="4"
                                Grid.ColumnSpan="3"
                                Grid.Row="3"
                                Grid.RowSpan="7"
                                Margin="10"
                                AutoGenerateColumns="False" 
                                telerik:StyleManager.Theme="Material"
                                ItemsSource="{Binding ProductosActualizar}"
                                 SelectedItem="{Binding SelectedProduct}"
                                IsReadOnly="True">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding Code}"
                                    Header="ID Producto"
                                    Width="180"
                                    TextWrapping="Wrap"/>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding Name}"
                                    Header="Nombre Producto"
                                    Width="370" 
                                    TextWrapping="Wrap">
                        <telerik:GridViewDataColumn.CellStyle>
                            <Style TargetType="telerik:GridViewCell">
                                <!-- Color de texto negro por defecto -->
                                <Setter Property="Foreground" Value="Black"/>
                                <!-- Color de texto negro por defecto -->
                                <Setter Property="Background" Value="White"/>
                                <!-- Validación dinámica -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NewProduct}" Value="True">
                                        <Setter Property="Background" Value="LightBlue"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </telerik:GridViewDataColumn.CellStyle>
                    </telerik:GridViewDataColumn>
                </telerik:RadGridView.Columns>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding SelectedProductToUpdateCommand}" CommandParameter="{Binding ElementName=RadGrdVProducts, Path=SelectedItem}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </telerik:RadGridView>
            <ContentControl Content="{Binding CurrentPage}"
                            Grid.Column="0"
                            Grid.Row="0"
                            Grid.RowSpan="13"
                            Grid.ColumnSpan="4"/>
        </Grid>
    </telerik:RadBusyIndicator>
</UserControl>
