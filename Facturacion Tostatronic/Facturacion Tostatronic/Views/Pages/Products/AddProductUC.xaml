<UserControl x:Class="Facturacion_Tostatronic.Views.Pages.Products.AddProductUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Facturacion_Tostatronic.Views.Pages.Products" xmlns:vm1="clr-namespace:Facturacion_Tostatronic.ViewModels.Products" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:local1="clr-namespace:Facturacion_Tostatronic.Validations.Productos" xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation" xmlns:global="clr-namespace:System.Globalization;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="1080" 
             d:DesignWidth="1920"
             Background="White"
             Loaded="UserControl_Loaded">
    <telerik:RadBusyIndicator IsBusy="{Binding GettingData}"
                              BusyContent="{Binding ProgressVall}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <telerik:LayoutControlGroup Grid.Row="1" 
                                        Orientation="Vertical"
                                        Visibility="{Binding EnableProductBase}">
                <Label Content="Agregar a la Pagina WEB?"
                   FontSize="16"/>
                <CheckBox HorizontalAlignment="Center"
                      Width="30"
                      Height="30"/>
            </telerik:LayoutControlGroup>
            <materialDesign:ColorZone Mode="Standard" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Margin="5,5,0,0" Height="80">
                <TextBlock Text="Agregar Producto" FontSize="38px"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </materialDesign:ColorZone>
            <TextBox x:Name="txtCode" Grid.Row="2" Grid.Column="0" Margin="10" FontSize="20" HorizontalContentAlignment="Left" materialDesign:HintAssist.Hint="Codigo:" materialDesign:HintAssist.IsFloating="True" IsEnabled="{Binding EnableProductBase}" TabIndex="0">
                <TextBox.Text>
                    <Binding Path="Product.Code" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <local1:EmptyDataRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <TextBox x:Name="txtName" Grid.Row="3" Grid.Column="0" Margin="10" FontSize="16" HorizontalContentAlignment="Left" materialDesign:HintAssist.Hint="Nombre:" materialDesign:HintAssist.IsFloating="True" IsEnabled="{Binding EnableProductBase}" TabIndex="1">
                <TextBox.Text>
                    <Binding Path="Product.Name" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <local1:EmptyDataRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <telerik:LayoutControlGroup Grid.Row="4" Orientation="Vertical">
                <telerik:Label Content="Cantidad" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" Foreground="#FF8F8F8F"/>
                <telerik:RadNumericUpDown Margin="5" Value="{Binding Product.Existence}" IsEnabled="{Binding EnableProductBase}" TabIndex="2"/>
            </telerik:LayoutControlGroup>
            <telerik:LayoutControlGroup Grid.Row="5" Orientation="Vertical">
                <telerik:Label Content="Cantidad Minima" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" Foreground="#FF8F8F8F"/>
                <telerik:RadNumericUpDown Margin="5" Value="{Binding Product.MinimumQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding EnableProductBase}" TabIndex="3"/>
            </telerik:LayoutControlGroup>
            <telerik:LayoutControlGroup Grid.Row="6" Orientation="Vertical">
                <telerik:Label Content="Precio Compra" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" Foreground="#FF8F8F8F"/>
                <telerik:RadNumericUpDown Margin="5" Value="{Binding Product.BuyPrice}" ValueFormat="Currency" IsEnabled="{Binding EnableProductBase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="4">
                    <telerik:RadNumericUpDown.NumberFormatInfo>
                        <global:NumberFormatInfo CurrencyDecimalDigits="2" CurrencySymbol="$"/>
                    </telerik:RadNumericUpDown.NumberFormatInfo>
                </telerik:RadNumericUpDown>
            </telerik:LayoutControlGroup>
            <telerik:LayoutControlGroup Grid.Row="7" Orientation="Vertical">
                <telerik:Label Content="Precio Minimo" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" Foreground="#FF8F8F8F"/>
                <telerik:RadNumericUpDown Margin="5" Value="{Binding Product.MinimumPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueFormat="Currency" IsEnabled="{Binding EnableProductBase}" TabIndex="5">
                    <telerik:RadNumericUpDown.NumberFormatInfo>
                        <global:NumberFormatInfo CurrencyDecimalDigits="2" CurrencySymbol="$"/>
                    </telerik:RadNumericUpDown.NumberFormatInfo>
                </telerik:RadNumericUpDown>
            </telerik:LayoutControlGroup>
            <telerik:LayoutControlGroup Grid.Row="8" Orientation="Vertical">
                <telerik:Label Content="Precio Distribuidor" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" Foreground="#FF8F8F8F"/>
                <telerik:RadNumericUpDown Margin="5" Value="{Binding Product.DistributorPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueFormat="Currency" IsEnabled="{Binding EnableProductBase}" TabIndex="6">
                    <telerik:RadNumericUpDown.NumberFormatInfo>
                        <global:NumberFormatInfo CurrencyDecimalDigits="2" CurrencySymbol="$"/>
                    </telerik:RadNumericUpDown.NumberFormatInfo>
                </telerik:RadNumericUpDown>
            </telerik:LayoutControlGroup>
            <telerik:LayoutControlGroup Grid.Row="9" Orientation="Vertical">
                <telerik:Label Content="Precio Publico" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" Foreground="#FF8F8F8F"/>
                <telerik:RadNumericUpDown Margin="5" Value="{Binding Product.PublicPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueFormat="Currency" IsEnabled="{Binding EnableProductBase}" TabIndex="7">
                    <telerik:RadNumericUpDown.NumberFormatInfo>
                        <global:NumberFormatInfo CurrencyDecimalDigits="2" CurrencySymbol="$"/>
                    </telerik:RadNumericUpDown.NumberFormatInfo>
                </telerik:RadNumericUpDown>
            </telerik:LayoutControlGroup>
            <telerik:LayoutControlGroup Grid.Row="10" Orientation="Vertical">
                <telerik:Label Content="Selecciona Imagenes" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" Foreground="#FF8F8F8F"/>
                <telerik:RadFilePathPicker Margin="5" FilePath="{Binding ImagePath, Mode=TwoWay}" IsEnabled="{Binding EnableProductBase}" TabIndex="8"/>
            </telerik:LayoutControlGroup>
            <TextBox x:Name="txtUPC" 
                 Grid.Row="1" 
                 Grid.Column="1"  
                 Margin="10" 
                 FontSize="16" 
                 HorizontalContentAlignment="Left" 
                 materialDesign:HintAssist.Hint="UPC:" 
                 materialDesign:HintAssist.IsFloating="True" 
                 Visibility="{Binding EnableProductBase}">
                <TextBox.Text>
                    <Binding Path="Product.UPC" Mode="TwoWay" UpdateSourceTrigger="LostFocus">
                        <Binding.ValidationRules>
                            <local1:EmptyDataRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <telerik:RadAutoCompleteBox	WatermarkContent="Codigo SAT..."
                                    Grid.Column="1"
                                    Grid.Row="2"
									x:Name="SatCodeAutoCompleteBox"
									TextSearchMode="Contains"
									AutoCompleteMode="Suggest"
									SelectionMode="Single"
									TextSearchPath="CompleteName"
									ItemsSource="{Binding CodigoSat}"
                                    SelectedItem="{Binding SelectedCode, Mode=TwoWay}"
									Margin="10,0,10,0"
                                    Height="25"
                                    VerticalAlignment="Center"
									NoResultsContent="Codigo No Enocntrado..." 
                                    Cursor="IBeam"
                                    Visibility="{Binding EnableProductBase}"/>

            <telerik:LayoutControlGroup Grid.Row="10"
                                        Grid.Column="1"
                            Orientation="Horizontal">
                <Button Height="50" 
    Margin="5,12,5,13" 
    Command="{Binding AddNewProductCommand}">
                    <StackPanel>
                        <Image Source="/Images/save.png" Width="35" Height="20"/>
                        <TextBlock Text="Guardar" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button Height="50" 
    Margin="5,12,5,13" 
    Command="{Binding CreateNewInvoiceCommand}">
                    <StackPanel>
                        <Image Source="/Images/cancel.png" Width="35" Height="20"/>
                        <TextBlock Text="Cancelar" FontSize="14"/>
                    </StackPanel>
                </Button>
            </telerik:LayoutControlGroup>
        </Grid>
    </telerik:RadBusyIndicator>
</UserControl>
