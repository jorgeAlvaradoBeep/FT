<UserControl x:Class="Facturacion_Tostatronic.Views.Pages.Orders.EstablecerPreciosUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Facturacion_Tostatronic.Views.Pages.Orders" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d" 
             Background="White"
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded">
    <telerik:RadBusyIndicator IsBusy="{Binding GettingData}" BusyContent="Cargando productos...">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <telerik:RadComboBox Grid.Row="0" 
                                 x:Name="cbOrdenes"
                                 ItemsSource="{Binding Ordenes}"
                                 SelectedValue="{Binding SelectedOrder}"
                                 SelectedIndex="-1"
                                 Text="Seleccione orden"
                                 Width="200"
                                 Margin="10"
                                 SelectionChanged="cbOrdenes_SelectionChanged"/>
            <telerik:RadGridView Grid.Row="1" 
                     x:Name="radGv"
                     ItemsSource="{Binding DetallesOrden}" 
                     AutoGenerateColumns="False"
                     VerticalAlignment="Top"
                     RowIndicatorVisibility="Collapsed"
                     CanUserFreezeColumns="true"
                     BorderThickness="0"
                     CanUserResizeColumns="True"
                     ShowGroupPanel="False"
                     IsReadOnly="False"
                     SelectedItem="{Binding SelectedItem}"
                                 CellEditEnded="radGv_CellEditEnded">

                <telerik:RadGridView.Columns>

                    <!-- Asumiendo que en tu clase base tienes `public string codigoProducto { get; set; }` -->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding codigoProducto}" 
                                    Header="Código" Width="120"/>

                    <!-- Tu propiedad se llama 'Nombre' (no 'NombreEs'), así que lo correcto es {Binding Nombre} -->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding Nombre}"
                                    Header="Nombre (ES)" Width="220" 
                                    TextWrapping="WrapWithOverflow"
                                    IsReadOnly="True"/>

                    <!-- Asumiendo que tienes `public int cantidad { get; set; }` -->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding cantidad}"
                                    Header="Cantidad" Width="60"
                                    TextWrapping="WrapWithOverflow" />

                    <!-- Asumiendo que el costo real está en la propiedad 'precio' (double en la base) -->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding precio}"
                                    Header="Costo" DataFormatString="{}{0:C3}"
                                    Width="Auto"
                                    TextWrapping="WrapWithOverflow"
                                    IsReadOnly="True" />

                    <!-- MinimoRecomendado -> property "MinimoRecomendado" -->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding MinimoRecomendado}"
                                    Header="Minimo R"
                                    DataFormatString="{}{0:C}"
                                    Width="Auto"
                                    TextWrapping="WrapWithOverflow"
                                    UniqueName="TargetPrice">
                        <telerik:GridViewDataColumn.CellStyle>
                            <Style TargetType="telerik:GridViewCell">
                                <Setter Property="Background" Value="LightGreen"/>
                            </Style>
                        </telerik:GridViewDataColumn.CellStyle>
                    </telerik:GridViewDataColumn>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding MinimoActual}"
                                                Header="Minimo A"
                                                DataFormatString="{}{0:C}"
                                                Width="Auto"
                                                TextWrapping="WrapWithOverflow">
                        <telerik:GridViewDataColumn.CellStyle>
                            <Style TargetType="telerik:GridViewCell">
                                <Setter Property="Background" Value="LightGreen"/>
                            </Style>
                        </telerik:GridViewDataColumn.CellStyle>
                    </telerik:GridViewDataColumn>
                    <!-- minimo -> property "minimo" (ojo con minúscula) -->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding minimo}"
                                    Header="Minimo"
                                                UniqueName="Minimo"
                                    DataFormatString="{}{0:C}"
                                    Width="Auto"
                                    TextWrapping="WrapWithOverflow">
                        <telerik:GridViewDataColumn.CellStyle>
                            <Style TargetType="telerik:GridViewCell">
                                <!-- Color de texto negro por defecto -->
                                <Setter Property="Foreground" Value="Black"/>
                                <!-- Color de texto negro por defecto -->
                                <Setter Property="Background" Value="LightGreen"/>
                                <!-- Validación dinámica -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MinimoMenor}" Value="True">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </telerik:GridViewDataColumn.CellStyle>
                    </telerik:GridViewDataColumn>

                    <!-- SubMinimo -> property "SubMinimo" -->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding SubMinimo}"
                                    Header="SubTotal M" 
                                    DataFormatString="{}{0:C}"
                                    Width="Auto"
                                    TextWrapping="WrapWithOverflow"
                                    IsReadOnly="True"/>

                    <!-- PorcentajeMinimo -> property "PorcentajeMinimo" -->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding PorcentajeMinimo}"
                                    Header="% Minimo"
                                    DataFormatString="{}{0:P}"
                                    Width="Auto"
                                    TextWrapping="WrapWithOverflow"
                                    IsReadOnly="True"/>

                    <!-- DistribuidorRecomendado -> "DistribuidorRecomendado" -->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding DistribuidorRecomendado}"
                                    Header="Distribuidor R"
                                    DataFormatString="{}{0:C}"
                                    Width="Auto"
                                    TextWrapping="WrapWithOverflow"
                                    IsReadOnly="True"/>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding DistribuidorActual}"
                            Header="Distribuidor A"
                            DataFormatString="{}{0:C}"
                            Width="Auto"
                            TextWrapping="WrapWithOverflow">
                        <telerik:GridViewDataColumn.CellStyle>
                            <Style TargetType="telerik:GridViewCell">
                                <Setter Property="Background" Value="LightGreen"/>
                            </Style>
                        </telerik:GridViewDataColumn.CellStyle>
                    </telerik:GridViewDataColumn>
                    <!-- distribuidor -> "distribuidor" (minúscula porque la propiedad se define con 'new decimal distribuidor' ) -->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding distribuidor}"
                                    Header="Distribuidor"
                                    UniqueName="Distribuidor"
                                    DataFormatString="{}{0:C}"
                                    Width="Auto"
                                    TextWrapping="WrapWithOverflow">
                        <telerik:GridViewDataColumn.CellStyle>
                            <Style TargetType="telerik:GridViewCell">
                                <!-- Color de texto negro por defecto -->
                                <Setter Property="Foreground" Value="Black"/>
                                <!-- Color de texto negro por defecto -->
                                <Setter Property="Background" Value="LightGreen"/>
                                <!-- Validación dinámica -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DistribuidorMenor}" Value="True">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </telerik:GridViewDataColumn.CellStyle>
                    </telerik:GridViewDataColumn>

                    <!-- SubDistribuidor -> "SubDistribuidor" -->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding SubDistribuidor}"
                                    Header="SubTotal D"
                                    DataFormatString="{}{0:C}"
                                    Width="Auto"
                                    TextWrapping="WrapWithOverflow"
                                    IsReadOnly="True"/>

                    <!-- PorcentajeDistribuidor -> "PorcentajeDistribuidor" -->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding PorcentajeDistribuidor}"
                                    Header="% D"
                                    DataFormatString="{}{0:P}"
                                    Width="Auto"
                                    TextWrapping="WrapWithOverflow"
                                    IsReadOnly="True"/>

                    <!-- PublicoRecomendado -> "PublicoRecomendado" -->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding PublicoRecomendado}"
                                    Header="Publico R"
                                    DataFormatString="{}{0:C}"
                                    Width="Auto"
                                    TextWrapping="WrapWithOverflow"
                                    IsReadOnly="True"/>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding PublicoActual}"
                            Header="Publico A"
                            DataFormatString="{}{0:C}"
                            Width="Auto"
                            TextWrapping="WrapWithOverflow">
                        <telerik:GridViewDataColumn.CellStyle>
                            <Style TargetType="telerik:GridViewCell">
                                <!-- Color de texto negro por defecto -->
                                <Setter Property="Foreground" Value="Black"/>
                                <!-- Color de texto negro por defecto -->
                                <Setter Property="Background" Value="LightGreen"/>
                                <!-- Validación dinámica -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PublicoMenor}" Value="True">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </telerik:GridViewDataColumn.CellStyle>
                    </telerik:GridViewDataColumn>
                    <!-- publico -> "publico" (minúscula) -->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding publico}"
                                    Header="Publico"
                                    UniqueName="Publico"
                                    DataFormatString="{}{0:C}"
                                    Width="Auto"
                                    TextWrapping="WrapWithOverflow">
                        <telerik:GridViewDataColumn.CellStyle>
                            <Style TargetType="telerik:GridViewCell">
                                <Setter Property="Background" Value="LightGreen"/>
                            </Style>
                        </telerik:GridViewDataColumn.CellStyle>
                    </telerik:GridViewDataColumn>

                    <!-- SubPublico -> "SubPublico" -->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding SubPublico}"
                                    Header="SubTotal P"
                                    DataFormatString="{}{0:C}"
                                    Width="Auto"
                                    TextWrapping="WrapWithOverflow"
                                    IsReadOnly="True"/>

                    <!-- PorcentajePublico -> "PorcentajePublico" -->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding PorcentajePublico}"
                                    Header="% P"
                                    DataFormatString="{}{0:P}"
                                    Width="Auto"
                                    TextWrapping="WrapWithOverflow"
                                    IsReadOnly="True"/>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
            <UniformGrid Grid.Row="2" Columns="3" Rows="1" Margin="10">
                <!-- Tabla 1: Resultados Mínimos -->
                <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <!-- Título -->
                        <TextBlock Grid.Row="0" Text="Resultados Mínimos" 
                           FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>

                        <!-- Venta Recomendada -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock Text="Venta Recomendada: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding SubTotalMinimo, StringFormat={}{0:C}}"/>
                        </StackPanel>

                        <!-- IVA de Venta -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="IVA de Venta: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding IvaMinimo, StringFormat={}{0:C}}" />
                        </StackPanel>

                        <!-- IVA Pagado -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                            <TextBlock Text="IVA Pagado: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding IvaPagado, StringFormat={}{0:C}}" />
                        </StackPanel>

                        <!-- IVA a Pagar -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal">
                            <TextBlock Text="IVA a Pagar: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding ImpuestoAPagarMinimo, StringFormat={}{0:C}}" />
                        </StackPanel>

                        <!-- Venta Bruta -->
                        <StackPanel Grid.Row="5" Orientation="Horizontal">
                            <TextBlock Text="Venta Bruta: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding VentaBrutaMinimo, StringFormat={}{0:C}}" />
                        </StackPanel>

                        <!-- Ganancia Real -->
                        <StackPanel Grid.Row="6" Orientation="Horizontal">
                            <TextBlock Text="Ganancia Real: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding GananciaRealMinimo, StringFormat={}{0:C}}" />
                        </StackPanel>

                        <!-- % Ganancia -->
                        <StackPanel Grid.Row="7" Orientation="Horizontal">
                            <TextBlock Text="% Ganancia: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding PorcentajeGananciaMinimo, StringFormat={}{0:P}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tabla 2: Resultados Distribuidor -->
                <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <!-- Título -->
                        <TextBlock Grid.Row="0" Text="Resultados Distribuidor" 
                           FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>

                        <!-- Venta Recomendada -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock Text="Venta Recomendada: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding SubTotalDistribuidor, StringFormat={}{0:C}}" />
                        </StackPanel>

                        <!-- IVA de Venta -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="IVA de Venta: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding IvaDistribuidor, StringFormat={}{0:C}}" />
                        </StackPanel>

                        <!-- IVA Pagado -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                            <TextBlock Text="IVA Pagado: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding IvaPagado, StringFormat={}{0:C}}" />
                        </StackPanel>

                        <!-- IVA a Pagar -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal">
                            <TextBlock Text="IVA a Pagar: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding ImpuestoAPagarDistribuidor, StringFormat={}{0:C}}" />
                        </StackPanel>

                        <!-- Venta Bruta -->
                        <StackPanel Grid.Row="5" Orientation="Horizontal">
                            <TextBlock Text="Venta Bruta: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding VentaBrutaDistribuidor, StringFormat={}{0:C}}" />
                        </StackPanel>

                        <!-- Ganancia Real -->
                        <StackPanel Grid.Row="6" Orientation="Horizontal">
                            <TextBlock Text="Ganancia Real: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding GananciaRealDistribuidor, StringFormat={}{0:C}}" />
                        </StackPanel>

                        <!-- % Ganancia -->
                        <StackPanel Grid.Row="7" Orientation="Horizontal">
                            <TextBlock Text="% Ganancia: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding PorcentajeGananciaDistribuidor, StringFormat={}{0:P}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tabla 3: Resultados Público -->
                <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <!-- Título -->
                        <TextBlock Grid.Row="0" Text="Resultados Público" 
                           FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>

                        <!-- Venta Recomendada -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock Text="Venta Recomendada: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding SubTotalPublico, StringFormat={}{0:C}}" />
                        </StackPanel>

                        <!-- IVA de Venta -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="IVA de Venta: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding IvaPublico, StringFormat={}{0:C}}" />
                        </StackPanel>

                        <!-- IVA Pagado -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                            <TextBlock Text="IVA Pagado: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding IvaPagado, StringFormat={}{0:C}}" />
                        </StackPanel>

                        <!-- IVA a Pagar -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal">
                            <TextBlock Text="IVA a Pagar: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding ImpuestoAPagarPublico, StringFormat={}{0:C}}" />
                        </StackPanel>

                        <!-- Venta Bruta -->
                        <StackPanel Grid.Row="5" Orientation="Horizontal">
                            <TextBlock Text="Venta Bruta: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding VentaBrutaPublico, StringFormat={}{0:C}}" />
                        </StackPanel>

                        <!-- Ganancia Real -->
                        <StackPanel Grid.Row="6" Orientation="Horizontal">
                            <TextBlock Text="Ganancia Real: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding GananciaRealPublico, StringFormat={}{0:C}}" />
                        </StackPanel>

                        <!-- % Ganancia -->
                        <StackPanel Grid.Row="7" Orientation="Horizontal">
                            <TextBlock Text="% Ganancia: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding PorcentajeGananciaPublico, StringFormat={}{0:P}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>
            <StackPanel Orientation="Horizontal"
            Grid.Row="6"
            HorizontalAlignment="Center">
                <Label Content="Total de la Orden: " 
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,0,5,0"/>
                <Label Content="{Binding CostoTotal}" 
                   FontWeight="Bold"
                   FontSize="14"
                       ContentStringFormat="{}{0:C}"
                   Margin="0,0,5,0"/>
                <telerik:RadButton Command="{Binding SavePricesCommand}"
                            BorderThickness="2"
                            CornerRadius="10"
                            ToolTipService.ToolTip="Guardar Precios">
                    <telerik:RadButton.Content>
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Center" 
                                    Margin="5">
                            <!-- Texto a la izquierda -->
                            <TextBlock Text="Guardar Precios"
                                    FontWeight="Bold"
                                    FontSize="14"
                                    Foreground="#FFFFFF" 
                                    VerticalAlignment="Center"
                                    Margin="0,0,15,0"/>
                            <Image Source="/Images/order1.png"
                                Width="24" 
                                Height="24"
                                Stretch="Uniform"/>
                        </StackPanel>
                    </telerik:RadButton.Content>

                    <!-- Estilo del botón -->
                    <telerik:RadButton.Style>
                        <Style TargetType="telerik:RadButton" 
BasedOn="{StaticResource {x:Type telerik:RadButton}}">
                            <!-- Colores inspirados en la paleta de Excel -->
                            <Setter Property="Background" Value="#1748c0"/>
                            <!-- Verde principal -->
                            <Setter Property="BorderBrush" Value="#0836a5"/>
                            <!-- Verde más oscuro para el borde -->
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontSize" Value="12"/>

                            <!-- Triggers para efectos visuales -->
                            <Style.Triggers>
                                <!-- Efecto hover -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2D854F"/>
                                    <!-- Verde más claro al pasar el mouse -->
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>

                                <!-- Efecto al presionar el botón -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#1B5C39"/>
                                    <!-- Un verde más oscuro al presionar -->
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </telerik:RadButton.Style>
                </telerik:RadButton>
                <telerik:RadButton Command="{Binding PriceListCommand}"
                            BorderThickness="2"
                            CornerRadius="10"
                            ToolTipService.ToolTip="Guardar Precios">
                    <telerik:RadButton.Content>
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Center" 
                                    Margin="5">
                            <!-- Texto a la izquierda -->
                            <TextBlock Text="Lista De Precios"
                                    FontWeight="Bold"
                                    FontSize="14"
                                    Foreground="#FFFFFF" 
                                    VerticalAlignment="Center"
                                    Margin="0,0,15,0"/>
                            <Image Source="/Images/excel.png"
                                Width="24" 
                                Height="24"
                                Stretch="Uniform"/>
                        </StackPanel>
                    </telerik:RadButton.Content>

                    <!-- Estilo del botón -->
                    <telerik:RadButton.Style>
                        <Style TargetType="telerik:RadButton" 
BasedOn="{StaticResource {x:Type telerik:RadButton}}">
                            <!-- Colores inspirados en la paleta de Excel -->
                            <Setter Property="Background" Value="#1748c0"/>
                            <!-- Verde principal -->
                            <Setter Property="BorderBrush" Value="#0836a5"/>
                            <!-- Verde más oscuro para el borde -->
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontSize" Value="12"/>

                            <!-- Triggers para efectos visuales -->
                            <Style.Triggers>
                                <!-- Efecto hover -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2D854F"/>
                                    <!-- Verde más claro al pasar el mouse -->
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>

                                <!-- Efecto al presionar el botón -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#1B5C39"/>
                                    <!-- Un verde más oscuro al presionar -->
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </telerik:RadButton.Style>
                </telerik:RadButton>
            </StackPanel>
        </Grid>
    </telerik:RadBusyIndicator>
</UserControl>
