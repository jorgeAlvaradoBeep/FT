<UserControl x:Class="Facturacion_Tostatronic.Views.Pages.Sales.Earnings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Facturacion_Tostatronic.Views.Pages.Sales" 
      xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation" 
      xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
      xmlns:vm="clr-namespace:Facturacion_Tostatronic.ViewModels.Sales"
      mc:Ignorable="d" 
      d:DesignHeight="450" 
      d:DesignWidth="800"
      Background="White">
    <UserControl.Resources>
        <vm:EarningsVM x:Key="saleVM"/>
    </UserControl.Resources>
    <telerik:RadBusyIndicator DataContext="{StaticResource saleVM}" IsBusy="{Binding GettinData}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0"
                        Grid.ColumnSpan="5"
                        Orientation="Vertical">
                <DatePicker x:Name="dpEventDate" 
                            SelectedDate="{Binding SelectedDate, Mode=TwoWay}" 
                            Height="35" 
                            Margin="10">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectedDateChanged">
                            <i:InvokeCommandAction Command="{Binding DaySalesSelectedDateCommand}"
                                                   CommandParameter="{Binding ElementName=dpEventDate, Path=SelectedDate}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </DatePicker>
            </StackPanel>
            <telerik:RadGridView    x:Name="RadGridView2" 
                                    GroupRenderMode="Flat"
                                    ItemsSource="{Binding Sales}"
                                    VerticalAlignment="Top"
                                    RowIndicatorVisibility="Collapsed"
                                    AutoGenerateColumns="False"
                                    CanUserFreezeColumns="False"
                                    BorderThickness="0"
                                    CanUserResizeColumns="True"
                                    ShowGroupPanel="False"
                                    BorderBrush="{x:Null}"
                                    Margin="10"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="5"
                                    Grid.Row="1"
                                    Grid.RowSpan="3"
                                    IsReadOnly="False">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="RowEditEnded">
                        <i:InvokeCommandAction Command="{Binding ChangeDataInfoCommand}" CommandParameter="{Binding ElementName=RadGrdVSales, Path=SelectedItem}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="Folio"
                                     DataMemberBinding="{Binding idVenta}" 
                                                Width="150"
                                                IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="ID Cliente"
                                     DataMemberBinding="{Binding idClienteNavigation.rfc}"
                                                Width="150"
                                                IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="Nombre o Razon Social"
                                     DataMemberBinding="{Binding idClienteNavigation.CompleteName}"
                                                Width="250"
                                                IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="Total Ingreso"
                                                DataMemberBinding="{Binding total, StringFormat={}{0:C}}"
                                                Width="100"
                                                IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="Total Costo"
                                                DataMemberBinding="{Binding Costototal, StringFormat={}{0:C}}"
                                                Width="100"
                                                IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="IVA Venta"
                                                DataMemberBinding="{Binding iva, StringFormat={}{0:C}}"
                                                Width="100"
                                                IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="IVA Pagada"
                                                DataMemberBinding="{Binding ivaPagada, StringFormat={}{0:C}}"
                                                Width="100"
                                                IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="IVA a Pagar"
                                                DataMemberBinding="{Binding ivaAPagar, StringFormat={}{0:C}}"
                                                Width="100"
                                                IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="IVA Retenido"
                                                DataMemberBinding="{Binding IVARetenido, Mode=TwoWay, StringFormat={}{0:C}}"
                                                Width="100"/>
                    <telerik:GridViewDataColumn Header="IVA Final"
                                                DataMemberBinding="{Binding IVAFinal, StringFormat={}{0:C}}"
                                                Width="100"
                                                IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="ISR Retenido"
                                                DataMemberBinding="{Binding ISRRetenido, Mode=TwoWay, StringFormat={}{0:C}}"
                                                Width="100"/>
                    <telerik:GridViewComboBoxColumn Header="Plataforma De Venta"
                                                    UniqueName="PlataformaVentaColumn"
                                                    DataMemberBinding="{Binding Comisiones.PlataformaId, Mode=TwoWay}"
                                                    DisplayMemberPath="Nombre"
                                                    SelectedValueMemberPath="Id"
                                                    ItemsSource="{Binding PlataformasDisponibles}"
                                                    Width="200"/>
                    <telerik:GridViewComboBoxColumn Header="Metodo de Pago Empleado"
                                                    UniqueName="MetodoPagoColumn"
                                                    DataMemberBinding="{Binding Comisiones.MetodoPagoId, Mode=TwoWay}"
                                                    DisplayMemberPath="Nombre"
                                                    SelectedValueMemberPath="Id"
                                                    ItemsSource="{Binding MetodosDePagoDisponibles}"
                                                    Width="200"/>
                    <telerik:GridViewDataColumn Header="Folio Plataforma"
                                                DataMemberBinding="{Binding Comisiones.FolioPlataforma, Mode=TwoWay}"
                                                Width="100"/>
                    <telerik:GridViewDataColumn Header="Envio"
                                                DataMemberBinding="{Binding Comisiones.Envio, Mode=TwoWay, StringFormat={}{0:C}}"
                                                Width="100"/>
                    <telerik:GridViewDataColumn Header="Comisión"
                                                DataMemberBinding="{Binding Comisiones.Comision, Mode=TwoWay, StringFormat={}{0:C}}"
                                                Width="100"/>
                    <telerik:GridViewDataColumn Header="Ganancia Total"
                                                DataMemberBinding="{Binding Comisiones.Ganancia, StringFormat={}{0:C}}"
                                                Width="100"
                                                IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="% Ganancia"
                                                DataMemberBinding="{Binding PGanancia, StringFormat={}{0}%}"
                                                Width="100"
                                                IsReadOnly="True"/>
                    <telerik:GridViewColumn Header="Buscar"
									Width="100" >
                        <telerik:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <telerik:RadButton  Content="Buscar"
                                Command="{Binding SaveNewComissionInfoCommand, Source={StaticResource saleVM}}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=telerik:GridViewRow}}" />
                            </DataTemplate>
                        </telerik:GridViewColumn.CellTemplate>
                    </telerik:GridViewColumn>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
            <!--<StackPanel Orientation="Vertical" Grid.Row="4" Grid.Column="3">
                <Label Content="Total Ganancias: "
                       Grid.Row="4"
                       Grid.Column="3"
                       FontSize="24"/>
                <Button Content="Importar Comisiones" Command="{Binding ImportCommissionFromExcelCommand}"/>
                <Button Content="Guardar Comisiones" 
                        Command="{Binding SaveComissionCommand}"
                        Margin="0,10,0,0"/>
            </StackPanel>
            
                <telerik:RadFilePathPicker Margin="5" 
           FilePath="{Binding ImagePath, Mode=TwoWay}"/>
            </StackPanel>-->
            <StackPanel Orientation="Vertical" Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Total Ganancias: "
                           Grid.Row="4"
                           Grid.Column="4"
                           FontSize="16"/>
                    <Label Content="{Binding TotalEarnings}"
                           Grid.Row="4"
                           Grid.Column="4"
                           ContentStringFormat="{}{0:C}"
                           FontSize="16"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Label Content="Tarj. Credito" FontSize="16"/>
                    <Label Content="{Binding TarjetaCredito}" ContentStringFormat="{}{0:c}" FontSize="16"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Label Content="Tarj. Debito" FontSize="16"/>
                    <Label Content="{Binding TarjetaDebito}" ContentStringFormat="{}{0:c}" FontSize="16"/>
                </StackPanel>
            </StackPanel>
            
            <StackPanel Orientation="Vertical"
                        Grid.Row="4"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Margin="5">
                <StackPanel Orientation="Horizontal" >
                    <Label Content="Total($) Ventas: "
                            FontSize="24"/>
                    <Label Content="{Binding TotalVentas}"
                            Grid.Row="4"
                            Grid.Column="4"
                           ContentStringFormat="{}{0:C}"
                            FontSize="24"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" >
                    <Label Content="Total Ventas: "
                            FontSize="24"/>
                    <Label Content="{Binding NumberOfSales, StringFormat={}{0:C}}"
                            Grid.Row="4"
                            Grid.Column="4"
                            FontSize="24"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Vertical"
                        Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Label Content="Efc. Recibido" FontSize="12"/>
                    <Label Content="{Binding EfectivoRecibido}" ContentStringFormat="{}{0:c}" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Label Content="Efectivo Pendiente" FontSize="12"/>
                    <Label Content="{Binding EfectivoPendiente}" ContentStringFormat="{}{0:c}" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Label Content="Trans. Recibido" FontSize="12"/>
                    <Label Content="{Binding TransferenciaRecibido}" ContentStringFormat="{}{0:c}" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Label Content="Trans Pendiente" FontSize="12"/>
                    <Label Content="{Binding TransferenciaPendiente}" ContentStringFormat="{}{0:c}" FontSize="12"/>
                </StackPanel>
                <!--<StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    
                    <Label Content="Fila Inicio" FontSize="24"/>
                    <telerik:RadNumericUpDown Value="{Binding FilaInicio}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Label Content="Fila Fin" FontSize="24"/>
                    <telerik:RadNumericUpDown Value="{Binding FilaFin}" />
                </StackPanel>-->
            </StackPanel>
        </Grid>
    </telerik:RadBusyIndicator>
</UserControl>
