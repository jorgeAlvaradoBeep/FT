<Window x:Class="Facturacion_Tostatronic.Views.OrdersV.CalculatePricesV"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Facturacion_Tostatronic.Views.OrdersV" 
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:con="clr-namespace:Facturacion_Tostatronic.Convertidores"
        mc:Ignorable="d"
        Title="Calcular Precios" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Window.Resources>
        <con:PorcentajeToColorConverter x:Key="PorcentajeToColorConverter"/>
    </Window.Resources>
    <telerik:RadBusyIndicator IsBusy="{Binding GettingData}" BusyContent="Cargando productos...">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal"
            Grid.Row="0"
                    Margin="5">
                <Label Content="Costo Envio:"
           Width="95"
           VerticalAlignment="Center"
           FontSize="16"/>
                <telerik:RadNumericUpDown Width="135"
                              Margin="0,0,0,5"
                              Value="{Binding OrdenComplete.CostoEnvio}"/>
                <Label Content="Agentes Ad:"
           Width="95"
           VerticalAlignment="Center"
           FontSize="16"/>
                <telerik:RadNumericUpDown Width="135"
                              Margin="0,0,0,5"
                              Value="{Binding OrdenComplete.CostoAA}"/>
                <Label Content="Tipo Cambio:"
           Width="105"
           VerticalAlignment="Center"
           FontSize="16"/>
                <telerik:RadNumericUpDown Width="135"
                              Margin="0,0,0,5"
                              Value="{Binding OrdenComplete.TipoCambio}"/>
            </StackPanel>
            <telerik:RadGridView Grid.Row="1" 
                             x:Name="radGv"
                             ItemsSource="{Binding OrdenComplete.ProductosDeOrdenesNavigation}" 
                             AutoGenerateColumns="False"
                             VerticalAlignment="Top"
                             RowIndicatorVisibility="Collapsed"
                             CanUserFreezeColumns="False"
                             BorderThickness="0"
                             CanUserResizeColumns="True"
                             ShowGroupPanel="False"
                             IsReadOnly="False"
                             SelectedItem="{Binding SelectedItem}"
                             CellEditEnded="radGv_CellEditEnded">
                <!--<i:Interaction.Triggers>
                <i:EventTrigger EventName="RowEditEnded">
                    <i:InvokeCommandAction Command="{Binding UpdateTPCommand}" CommandParameter="{Binding ElementName=radGv, Path=SelectedItem}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>-->
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding CodigoProducto}" Header="Código" Width="120"/>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding NombreEs}" Header="Nombre (ES)" Width="220" TextWrapping="WrapWithOverflow" IsReadOnly="True"/>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding Cantidad}" Header="Cantidad"  Width="60" TextWrapping="WrapWithOverflow"/>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding Precio}" Header="Precio" DataFormatString="{}{0:C}"  Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True"/>
                    <!--<telerik:GridViewDataColumn DataMemberBinding="{Binding SubTotal}" Header="Sub Total" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True"/>-->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding TargetPrice}" Header="Precio Tar" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" UniqueName="TargetPrice">
                        <telerik:GridViewDataColumn.CellStyle>
                            <Style TargetType="telerik:GridViewCell">
                                <!-- Color de texto negro por defecto -->
                                <Setter Property="Background" Value="LightGreen"/>
                            </Style>
                        </telerik:GridViewDataColumn.CellStyle>
                    </telerik:GridViewDataColumn>
                    <!--<telerik:GridViewDataColumn DataMemberBinding="{Binding SubTarget}" Header="SubTotal Tar" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True">
                    <telerik:GridViewDataColumn.CellStyle>
                        <Style TargetType="telerik:GridViewCell">
                            -->
                    <!-- Color de texto negro por defecto -->
                    <!--
                            <Setter Property="Background" Value="LightGreen"/>
                        </Style>
                    </telerik:GridViewDataColumn.CellStyle>
                </telerik:GridViewDataColumn>-->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding PrecioMXN}" Header="MXN" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True"/>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding PorcentajeOrden}" Header="% Pedido" DataFormatString="{}{0:P}" Width="Auto" TextWrapping="WrapWithOverflow" UniqueName="Porcentaje"/>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding PrecioMXNTarget}" Header="MXN Tar" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True">
                        <telerik:GridViewDataColumn.CellStyle>
                            <Style TargetType="telerik:GridViewCell">
                                <!-- Color de texto negro por defecto -->
                                <Setter Property="Background" Value="LightGreen"/>
                            </Style>
                        </telerik:GridViewDataColumn.CellStyle>
                    </telerik:GridViewDataColumn>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding PorcentajeTarget}" Header="% Pedido Tar" DataFormatString="{}{0:P}" Width="Auto" TextWrapping="WrapWithOverflow">
                        <telerik:GridViewDataColumn.CellStyle>
                            <Style TargetType="telerik:GridViewCell">
                                <!-- Color de texto negro por defecto -->
                                <Setter Property="Background" Value="LightGreen"/>
                            </Style>
                        </telerik:GridViewDataColumn.CellStyle>
                    </telerik:GridViewDataColumn>
                    <!--<telerik:GridViewDataColumn DataMemberBinding="{Binding CostoEnvio}" Header="Costo Envio" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True"/>-->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding CostoEnvioPP}" Header="Costo E/A PP" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True"/>
                    <!--<telerik:GridViewDataColumn DataMemberBinding="{Binding CostoEnvioTarget}" Header="Costo Envio Tar" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True">
                    <telerik:GridViewDataColumn.CellStyle>
                        <Style TargetType="telerik:GridViewCell">
                            -->
                    <!-- Color de texto negro por defecto -->
                    <!--
                            <Setter Property="Background" Value="LightGreen"/>
                        </Style>
                    </telerik:GridViewDataColumn.CellStyle>
                </telerik:GridViewDataColumn>-->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding CostoPPTaerget}" Header="Costo E/A Tar" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True">
                        <telerik:GridViewDataColumn.CellStyle>
                            <Style TargetType="telerik:GridViewCell">
                                <!-- Color de texto negro por defecto -->
                                <Setter Property="Background" Value="LightGreen"/>
                            </Style>
                        </telerik:GridViewDataColumn.CellStyle>
                    </telerik:GridViewDataColumn>
                    <!--<telerik:GridViewDataColumn DataMemberBinding="{Binding CostoAI}" Header="Costo Ant Imp" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True"/>-->
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding CostoTarget}" Header="Costo Tar" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True">
                        <telerik:GridViewDataColumn.CellStyle>
                            <Style TargetType="telerik:GridViewCell">
                                <!-- Color de texto negro por defecto -->
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="Background" Value="LightGreen"/>
                                <!-- Validación dinámica -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CostoMenorTarget}" Value="True">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </telerik:GridViewDataColumn.CellStyle>
                    </telerik:GridViewDataColumn>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding Costo}" Header="Precio IVA" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True">
                        <telerik:GridViewDataColumn.CellStyle>
                            <Style TargetType="telerik:GridViewCell">
                                <!-- Color de texto negro por defecto -->
                                <Setter Property="Foreground" Value="Black"/>
                                <!-- Validación dinámica -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CostoMenor}" Value="True">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </telerik:GridViewDataColumn.CellStyle>
                    </telerik:GridViewDataColumn>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding CostoActual}" Header="Costo Actual" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True"/>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding MinimoRecomendado}" Header="Minimo R" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True">
                        <telerik:GridViewDataColumn.CellStyle>
                            <Style TargetType="telerik:GridViewCell">
                                <!-- Color de texto negro por defecto -->
                                <Setter Property="Foreground" Value="Black"/>
                                <!-- Color de texto negro por defecto -->
                                <Setter Property="Background" Value="Cyan"/>
                                <!-- Validación dinámica -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MinimoMenor}" Value="True">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </telerik:GridViewDataColumn.CellStyle>
                    </telerik:GridViewDataColumn>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding MinimoRecomendadoTarget}" Header="Minimo R Tar" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True">
                        <telerik:GridViewDataColumn.CellStyle>
                            <Style TargetType="telerik:GridViewCell">
                                <!-- Color de texto negro por defecto -->
                                <Setter Property="Foreground" Value="Black"/>
                                <!-- Color de texto negro por defecto -->
                                <Setter Property="Background" Value="Cyan"/>
                                <!-- Validación dinámica -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BMinimoRecomendadoTarget}" Value="True">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </telerik:GridViewDataColumn.CellStyle>
                    </telerik:GridViewDataColumn>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding MinimoActual}" 
                                            Header="Minimo Act" 
                                            DataFormatString="{}{0:C}"
                                            IsReadOnly="True"/>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding Minimo}" Header="Minimo" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow"/>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding SubTotal}" Header="% Minimo" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True"/>
                    <!--<telerik:GridViewDataColumn DataMemberBinding="{Binding DistribuidorRecomendado}" Header="Distribuidor R" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding DistribuidorActual}" Header="Distribuidor Act" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding Distribuidor}" Header="Distribuidor" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding SubTotal}" Header="% Distribuidor" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding PublicoRecomendado}" Header="Publico R" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding PublicoActual}" Header="Publico Act" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding Publico}" Header="Publico" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding SubTotal}" Header="% Publico" DataFormatString="{}{0:C}" Width="Auto" TextWrapping="WrapWithOverflow" IsReadOnly="True"/>-->
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
            <StackPanel Orientation="Horizontal"
            Grid.Row="2">
                <Label Content="Gastos EA MXN: "
                   VerticalAlignment="Center"/>
                <Label Content="{Binding GastosEA}"
                   ContentStringFormat="{}{0:C2}"
                   VerticalAlignment="Center"
                   FontWeight="Bold"/>

                <Label Content="Total Porcentaje: "
                   VerticalAlignment="Center"/>
                <Label Content="{Binding TotalPorcentaje}"
                   ContentStringFormat="{}{0:P2}"
                   VerticalAlignment="Center"
                   FontWeight="Bold"
                   Foreground="{Binding TotalPorcentaje, Converter={StaticResource PorcentajeToColorConverter}}"/>
                <Label Content="Subtotal Target: "
                    VerticalAlignment="Center"/>
                <Label Content="{Binding SubTotalTarget}"
                   ContentStringFormat="{}{0:C2}"
                   VerticalAlignment="Center"
                   FontWeight="Bold"/>

                <Label Content="Porcentaje Target: "
                   VerticalAlignment="Center"/>
                <Label Content="{Binding PorcentageTarget}"
                   ContentStringFormat="{}{0:P0}"
                   VerticalAlignment="Center"
                   FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                    Grid.Row="3">
                <Label Content="Sub Material USD: "
                   VerticalAlignment="Center"
                   FontSize="12"/>
                <Label Content="{Binding OrdenComplete.SubTotal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=C}"
                   ContentStringFormat="{}{0:C2}"
                   VerticalAlignment="Center"
                   FontSize="12"
                   FontWeight="Bold"/>
                <Label Content="Total USD: "
                   VerticalAlignment="Center"
                   FontSize="12"/>
                <Label Content="{Binding OrdenComplete.TotalUSD, StringFormat=C}"
                   ContentStringFormat="{}{0:C2}"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   FontSize="12"/>
                <Label Content="Gasto Material MXN: "
           VerticalAlignment="Center"
           FontSize="12"/>
                <Label Content="{Binding OrdenComplete.GastoMaterialMx, StringFormat=C}"
                   ContentStringFormat="{}{0:C2}"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   FontSize="12"/>
                <Label Content="IVA MXN: "
           VerticalAlignment="Center"
           FontSize="12"/>
                <Label Content="{Binding OrdenComplete.IVAMx, StringFormat=C}"
                   ContentStringFormat="{}{0:C2}"
                    FontWeight="Bold"
                   VerticalAlignment="Center"
                   FontSize="12"/>
                <Label Content="Envio MXN: "
           VerticalAlignment="Center"
           FontSize="12"/>
                <Label Content="{Binding OrdenComplete.EnvioMx, StringFormat=C}"
                   ContentStringFormat="{}{0:C2}"
                    FontWeight="Bold"
                   VerticalAlignment="Center"
                   FontSize="12"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
            Grid.Row="4">
                <Label Content="Gastos E/A: "
           VerticalAlignment="Center"
           FontSize="12"/>
                <Label Content="{Binding OrdenComplete.GastosEA, StringFormat=C}"
                   ContentStringFormat="{}{0:C2}"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   FontSize="12"/>
                <Label Content="Total Gatos MXN: "
                   VerticalAlignment="Center"
                   FontSize="12"/>
                <Label Content="{Binding OrdenComplete.TotalGastosMx, StringFormat=C}"
                   ContentStringFormat="{}{0:C2}"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   FontSize="12"/>
                <Label Content="% Ganancia:"
           Width="95"
           VerticalAlignment="Center"
           FontSize="16"/>
                <telerik:RadNumericUpDown Width="135"
                              Margin="0,0,0,5"
                              Value="{Binding OrdenComplete.PorcentajeGanancia}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
            Grid.Row="6"
            HorizontalAlignment="Center">
                <Button Content="Guardar Target Prices" 
            Command="{Binding SaverTargetPricesOrderCommand}"
            IsEnabled="{Binding IsProductExtractionenabled}"/>
                <Button Content="Guardar Info Orden" 
            IsEnabled="{Binding IsProductExtractionenabled}"
            Command="{Binding SaveOrderInfoCommand}"/>
                <telerik:RadButton Command="{Binding StablishOrderCommand}"
                            BorderThickness="2"
                            CornerRadius="10"
                            ToolTipService.ToolTip="Cargar productos">
                    <telerik:RadButton.Content>
                        <StackPanel Orientation="Horizontal" 
     HorizontalAlignment="Center" 
     VerticalAlignment="Center" 
     Margin="5">
                            <!-- Texto a la izquierda -->
                            <TextBlock Text="Establecer Orden"
                                    FontWeight="Bold"
                                    FontSize="14"
                                    Foreground="#FFFFFF" 
                                    VerticalAlignment="Center"
                                    Margin="0,0,15,0"/>
                            <Image Source="/Images/order1.png"
                                Width="24" 
                                Height="24"
                                Stretch="Uniform"/>
                        </StackPanel>
                    </telerik:RadButton.Content>

                    <!-- Estilo del botón -->
                    <telerik:RadButton.Style>
                        <Style TargetType="telerik:RadButton" 
BasedOn="{StaticResource {x:Type telerik:RadButton}}">
                            <!-- Colores inspirados en la paleta de Excel -->
                            <Setter Property="Background" Value="#1748c0"/>
                            <!-- Verde principal -->
                            <Setter Property="BorderBrush" Value="#0836a5"/>
                            <!-- Verde más oscuro para el borde -->
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontSize" Value="12"/>

                            <!-- Triggers para efectos visuales -->
                            <Style.Triggers>
                                <!-- Efecto hover -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2D854F"/>
                                    <!-- Verde más claro al pasar el mouse -->
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>

                                <!-- Efecto al presionar el botón -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#1B5C39"/>
                                    <!-- Un verde más oscuro al presionar -->
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </telerik:RadButton.Style>
                </telerik:RadButton>
            </StackPanel>
        </Grid>
    </telerik:RadBusyIndicator>
</Window>
